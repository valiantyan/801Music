<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="20dp">

    <TextView
        android:id="@+id/playerNowPlayingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_now_playing"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerAlbumArtCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="26dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerNowPlayingLabel">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/playerAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/player_album_art"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerInfoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerAlbumArtCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/playerSongTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="@string/player_song_title_placeholder"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/on_surface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/playerSongArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/player_song_artist_placeholder"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_variant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playerSongTitle" />

            <com.google.android.material.slider.Slider
                android:id="@+id/playerProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/player_progress"
                android:valueFrom="0"
                android:valueTo="100"
                app:thumbColor="@color/tertiary"
                app:trackColorActive="@color/tertiary"
                app:trackColorInactive="@color/surface_variant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playerSongArtist" />

            <TextView
                android:id="@+id/playerPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/player_time_placeholder"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_surface_variant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playerProgress" />

            <TextView
                android:id="@+id/playerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/player_time_placeholder"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_surface_variant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playerProgress" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/playerActionChips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playerDuration">

                <com.google.android.material.chip.Chip
                    android:id="@+id/playerChipQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_chip_queue"
                    android:textColor="@color/on_surface"
                    app:chipBackgroundColor="@color/surface_variant"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/playerChipLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_chip_lyrics"
                    android:textColor="@color/on_surface"
                    app:chipBackgroundColor="@color/surface_variant"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/playerChipDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_chip_device"
                    android:textColor="@color/on_surface"
                    app:chipBackgroundColor="@color/surface_variant"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerInfoCard">

        <ImageButton
            android:id="@+id/playerPrevious"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/player_previous"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/on_surface" />

        <ImageButton
            android:id="@+id/playerPlayPause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_control_button_primary"
            android:contentDescription="@string/player_play_pause"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/on_primary" />

        <ImageButton
            android:id="@+id/playerNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/player_next"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/on_surface" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
